# Base Sepolia receiver for a real x402 independent-probe request.
ATLAS_PAY_TO=
ATLAS_NETWORK=base-sepolia
ATLAS_PORT=4030

# Durable production storage. When this is set, Atlas stores evidence,
# Sentinel identities, wallet sessions and links in Postgres instead of .runtime.
# Render's internal Postgres URL does not require ATLAS_DATABASE_SSL.
DATABASE_URL=
ATLAS_DATABASE_SSL=false

# Comma-separated dashboard origins permitted to request a wallet signature.
# The two public Atlas Vercel origins and local loopback development are
# allowed in code; use this only for a deliberate additional dashboard domain.
ATLAS_WALLET_AUTH_ORIGINS=

# Server-only EIP-191 signer. Generate and store this only in the deployment
# platform's encrypted environment variables; never commit it.
ATLAS_SENTINEL_PRIVATE_KEY=

# Public API origin used by verification and paid-probe scripts after hosting.
# ATLAS_API_URL=https://api.example.com

# Official Portaldot mainnet WebSocket endpoint. This app only reads it.
ATLAS_PORTALDOT_ENDPOINT=wss://mainnet.portaldot.io

# Recorded from the official Portaldot Mainnet probe on 2026-10-12.
ATLAS_EXPECTED_GENESIS=0x83b5212c69f85f3996f8696bb35bf913af51b176a5f53d0a74fd3a83dc0b8a54

# Deliberately separate from the live Mainnet probe. These are required only
# for the read-only contract deployment preflight and must identify an
# organizer-provided testnet. The preflight rejects Mainnet's genesis hash and
# never signs, uploads Wasm, instantiates a contract, or submits an extrinsic.
ATLAS_CONTRACT_DEPLOYMENT_NETWORK=testnet
ATLAS_CONTRACT_ENDPOINT=
ATLAS_CONTRACT_EXPECTED_GENESIS=
ATLAS_CONTRACT_EXPLORER_URL=

# Optional local Portaldot development node, started manually in WSL. The
# readiness verifier is read-only and defaults to ws://127.0.0.1:9944.
ATLAS_LOCAL_PORTALDOT_ENDPOINT=ws://127.0.0.1:9944

# A paid x402 corroboration is never automatic. These are intentionally blank:
# provide them only for a separately authorized, one-time payment after the
# agent has reserved a valid incident and the live 402 offer was reviewed.
ATLAS_EXPECTED_X402_PAY_TO=
ATLAS_PAYER_PRIVATE_KEY=
ATLAS_PAID_PROBE_CONFIRMATION=
