{
  "name": "portaldot-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portaldot Atlas: signed, live endpoint evidence and paid independent corroboration.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent:observe": "node src/reliability-agent.js",
    "init:receiver": "node scripts/init-receiver.mjs",
    "init:signer": "node scripts/init-signer.mjs",
    "probe:paid": "node scripts/paid-independent-probe.mjs",
    "epoch:build": "node scripts/build-epoch-plan.mjs",
    "package:sentinel": "powershell -ExecutionPolicy Bypass -File scripts/package-sentinel.ps1",
    "start": "node src/server.js",
    "probe": "node src/cli-probe.js",
    "verify:monitor": "node scripts/verify-live-monitor.mjs",
    "verify:sentinel": "node scripts/verify-sentinel-ingestion.mjs",
    "verify:sentinel-key": "node scripts/verify-sentinel-key-canonicalization.mjs",
    "verify:epoch-plan": "node scripts/verify-epoch-plan.mjs",
    "verify:epoch-contract-compat": "node scripts/verify-epoch-contract-compatibility.mjs",
    "verify:contract-capabilities": "node scripts/verify-portaldot-contract-capabilities.mjs",
    "verify:contract-deployment-preflight": "node scripts/verify-contract-deployment-preflight.mjs",
    "verify:hosted-postgres": "node scripts/verify-hosted-postgres.mjs",
    "verify:x402-challenge": "node scripts/verify-x402-challenge.mjs",
    "verify:live": "node scripts/verify-live-probe.mjs"
  },
  "dependencies": {
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "viem": "^2.38.2",
    "ws": "^8.18.3"
  }
}
